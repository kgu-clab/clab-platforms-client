{
  "name": "clab-platforms-v2",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "commit": "cz",
    "commitlint": "commitlint",
    "agent:init": "node .agent/scripts/init.mjs",
    "agent:check-local": "node .agent/scripts/check-local-files.mjs",
    "agent:check-diff": "node .agent/scripts/check-diff-hygiene.mjs",
    "agent:check": "node .agent/scripts/check-diff-hygiene.mjs",
    "agent:verify": "node .agent/scripts/suggest-verification.mjs",
    "agent:screenshots": "node .agent/scripts/make-screenshot-plan.mjs",
    "agent:pr-evidence": "node .agent/scripts/collect-pr-evidence.mjs",
    "agent:test": "node --test .agent/scripts/harness.test.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "cz-emoji": "1.3.2-canary.2",
    "lefthook": "^2.1.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "turbo": "^1.13.0"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "20.x"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-emoji"
    }
  }
}
